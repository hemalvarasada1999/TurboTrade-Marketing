VITE_SEBI_RA_NUMBER=
VITE_BSE_ENLISTMENT_NUMBER=
VITE_CONTACT_EMAIL=
VITE_LEGAL_EMAIL=
VITE_PARTNER_EMAIL=
VITE_CONTACT_PHONE=
VITE_UPI_HANDLE=
