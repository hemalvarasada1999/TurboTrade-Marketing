# Copy to .env and fill in. See src/lib/company.ts for what each value is for.
VITE_GOOGLE_SHEET_URL=
VITE_GOOGLE_SHEET_DEPLOYMENT_ID=
VITE_APP_URL=https://app.turbotrade.ai
# Public strategy list on the home page. Optional; this is the default.
VITE_API_URL=https://appapi.turbotrade.ai

# Company & regulatory details — required; the build fails without them.
VITE_COMPANY_CIN=
VITE_SEBI_RA_NUMBER=
VITE_BSE_ENLISTMENT_NUMBER=
VITE_CONTACT_EMAIL=
VITE_LEGAL_EMAIL=
VITE_PARTNER_EMAIL=
VITE_CONTACT_PHONE=
VITE_PARTNER_PHONE=
VITE_UPI_HANDLE=

# Social profiles (footer) and the floating WhatsApp button — required.
# See src/lib/social.tsx. VITE_SOCIAL_X_HANDLE is used in index.html's
# twitter:site tag. VITE_WHATSAPP_NUMBER is the click-to-chat number in any
# format, country code included; VITE_WHATSAPP_MESSAGE pre-fills the chat
# (optional).
VITE_SOCIAL_X_URL=
VITE_SOCIAL_X_HANDLE=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_LINKEDIN_URL=
VITE_SOCIAL_TELEGRAM_URL=
VITE_SOCIAL_WHATSAPP_CHANNEL_URL=
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=

# Meta Pixel (src/lib/metaPixel.ts) — optional; unset means no Pixel.
# The dataset ID is public (every visitor's browser sees it). Set it in the
# Vercel PRODUCTION environment only. The Pixel also refuses to load on any
# host not listed in VITE_META_PIXEL_HOSTS (default: turbotrade.ai,
# www.turbotrade.ai), so previews and local builds stay out of the
# production dataset. For local testing add localhost in .env.local and use
# Events Manager → Test Events.
VITE_META_PIXEL_ID=
VITE_META_PIXEL_HOSTS=
